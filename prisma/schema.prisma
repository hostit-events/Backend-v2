generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserRole {
  BUYER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventCategory {
  CONCERT
  CONFERENCE
  WORKSHOP
  PARTY
  CORPORATE
  SPORTS
  OTHER
}

enum TicketStatus {
  PENDING
  CONFIRMED
  USED
  CANCELLED
  REFUNDED
}

enum DeliveryChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  MONNIFY
  BLOCKRADAR
  CRYPTO
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BlockchainTxType {
  MINT
  CREATE_EVENT
  CHECKIN
  WITHDRAW
  SET_FEES
}

enum BlockchainTxStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum KycTier {
  NONE
  BASIC
  ENHANCED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ============ MODELS ============

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique
  password             String
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  phone                String?
  role                 UserRole  @default(BUYER)
  walletAddress        String?   @map("wallet_address")
  blockradarAddressId  String?   @map("blockradar_address_id")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organizerProfile OrganizerProfile?
  events           Event[]
  tickets          Ticket[]
  payouts          Payout[]
  notifications    Notification[]

  @@map("users")
}

model OrganizerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bvn             String?
  bvnVerified     Boolean   @default(false) @map("bvn_verified")
  bankName        String?   @map("bank_name")
  bankCode        String?   @map("bank_code")
  accountNumber   String?   @map("account_number")
  accountName     String?   @map("account_name")
  bankVerified    Boolean   @default(false) @map("bank_verified")
  kycTier         KycTier   @default(NONE) @map("kyc_tier")
  kycStatus       KycStatus @default(PENDING) @map("kyc_status")
  governmentIdUrl String?   @map("government_id_url")
  selfieUrl       String?   @map("selfie_url")
  businessName    String?   @map("business_name")
  businessAddress String?   @map("business_address")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("organizer_profiles")
}

model Event {
  id                String        @id @default(uuid()) @db.Uuid
  organizerId       String        @map("organizer_id") @db.Uuid
  name              String        @db.VarChar(100)
  slug              String        @unique
  description       String
  venue             String        @db.VarChar(200)
  location          String
  category          EventCategory
  coverImage        String?       @map("cover_image")
  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  purchaseStartTime DateTime      @map("purchase_start_time")
  status            EventStatus   @default(DRAFT)
  onChainTicketId   BigInt?       @map("on_chain_ticket_id")
  isFree            Boolean       @default(false) @map("is_free")
  isRefundable      Boolean       @default(false) @map("is_refundable")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organizer              User                    @relation(fields: [organizerId], references: [id])
  ticketTypes            TicketType[]
  tickets                Ticket[]
  transactions           Transaction[]
  payouts                Payout[]
  blockchainTransactions BlockchainTransaction[]

  @@index([organizerId])
  @@map("events")
}

model TicketType {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  name           String
  description    String?
  price          Decimal   @db.Decimal
  quantity       Int
  maxPerUser     Int       @default(5) @map("max_per_user")
  soldCount      Int       @default(0) @map("sold_count")
  salesStartDate DateTime? @map("sales_start_date")
  salesEndDate   DateTime? @map("sales_end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

model Ticket {
  id              String          @id @default(uuid()) @db.Uuid
  ticketTypeId    String          @map("ticket_type_id") @db.Uuid
  eventId         String          @map("event_id") @db.Uuid
  buyerId         String?         @map("buyer_id") @db.Uuid
  buyerEmail      String          @map("buyer_email")
  buyerName       String          @map("buyer_name")
  buyerPhone      String?         @map("buyer_phone")
  reference       String          @unique
  qrCode          String?         @map("qr_code")
  tokenId         Int?            @map("token_id")
  status          TicketStatus    @default(PENDING)
  deliveryChannel DeliveryChannel @map("delivery_channel")
  checkedInAt     DateTime?       @map("checked_in_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  ticketType             TicketType              @relation(fields: [ticketTypeId], references: [id])
  event                  Event                   @relation(fields: [eventId], references: [id])
  buyer                  User?                   @relation(fields: [buyerId], references: [id])
  transactions           Transaction[]
  blockchainTransactions BlockchainTransaction[]
  notifications          Notification[]

  @@index([eventId])
  @@index([eventId, buyerEmail], map: "idx_ticket_event_buyer")
  @@map("tickets")
}

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  ticketId          String?           @map("ticket_id") @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  buyerEmail        String            @map("buyer_email")
  amount            Decimal           @db.Decimal
  currency          String            @default("NGN")
  provider          PaymentProvider
  providerReference String?           @map("provider_reference")
  status            TransactionStatus @default(PENDING)
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id])
  event  Event   @relation(fields: [eventId], references: [id])

  @@index([providerReference])
  @@index([eventId])
  @@map("transactions")
}

model Payout {
  id                String          @id @default(uuid()) @db.Uuid
  organizerId       String          @map("organizer_id") @db.Uuid
  eventId           String          @map("event_id") @db.Uuid
  amount            Decimal         @db.Decimal
  currency          String          @default("NGN")
  provider          PaymentProvider
  providerReference String?         @map("provider_reference")
  status            PayoutStatus    @default(PENDING)
  bankName          String?         @map("bank_name")
  bankCode          String?         @map("bank_code")
  accountNumber     String?         @map("account_number")
  accountName       String?         @map("account_name")
  scheduledDate     DateTime        @map("scheduled_date")
  processedAt       DateTime?       @map("processed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organizer User  @relation(fields: [organizerId], references: [id])
  event     Event @relation(fields: [eventId], references: [id])

  @@index([organizerId])
  @@index([eventId])
  @@map("payouts")
}

model BlockchainTransaction {
  id        String             @id @default(uuid()) @db.Uuid
  ticketId  String?            @map("ticket_id") @db.Uuid
  eventId   String?            @map("event_id") @db.Uuid
  txHash    String?            @map("tx_hash")
  type      BlockchainTxType
  status    BlockchainTxStatus @default(PENDING)
  retries   Int                @default(0)
  error     String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id])
  event  Event?  @relation(fields: [eventId], references: [id])

  @@index([txHash])
  @@index([eventId])
  @@map("blockchain_transactions")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  ticketId  String?             @map("ticket_id") @db.Uuid
  channel   NotificationChannel
  type      String
  status    NotificationStatus  @default(PENDING)
  metadata  Json?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([userId])
  @@index([ticketId])
  @@map("notifications")
}
