generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserRole {
  BUYER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventCategory {
  CONCERT
  CONFERENCE
  WORKSHOP
  PARTY
  CORPORATE
  SPORTS
  OTHER
}

enum TicketStatus {
  PENDING
  CONFIRMED
  USED
  CANCELLED
  REFUNDED
}

enum DeliveryChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  MONNIFY
  BLOCKRADAR
  CRYPTO
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BlockchainTxType {
  MINT
  CREATE_EVENT
  CHECKIN
  WITHDRAW
  SET_FEES
}

enum BlockchainTxStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum KycTier {
  NONE
  BASIC
  ENHANCED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Wallet custody model. Default DEVELOPER_CONTROLLED — platform holds
// keys for buyers + organizers (see hostit skill §3B.2). Future opt-in
// upgrade path to USER_CONTROLLED / MODULAR for power-user organizers.
enum WalletType {
  DEVELOPER_CONTROLLED
  USER_CONTROLLED
  MODULAR
}

// Async wallet provisioning state. NULL until first enqueue (admin
// users never enter the flow). FAILED surfaces to the admin retry
// endpoint (#64).
enum WalletCreationStatus {
  PENDING
  CREATED
  FAILED
}

// ============ MODELS ============

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  role      UserRole @default(BUYER)

  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organizerProfile OrganizerProfile?
  events           Event[]
  tickets          Ticket[]
  payouts          Payout[]
  notifications    Notification[]
  wallets          UserWallet[]

  @@map("users")
}

/// Per-(user, chain, walletType) wallet record. A user can have many —
/// one per chain they transact on (Base, Solana, etc) and/or one per
/// custody type if they opt into a modular/passkey wallet later.
/// See hostit skill §3B for the custody model.
model UserWallet {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  circleWalletId    String?               @unique @map("circle_wallet_id")
  circleWalletSetId String?               @map("circle_wallet_set_id")
  address           String?
  chain             String
  walletType        WalletType            @default(DEVELOPER_CONTROLLED) @map("wallet_type")
  isPrimary         Boolean               @default(false) @map("is_primary")
  creationStatus    WalletCreationStatus? @map("creation_status")
  creationError     String?               @map("creation_error")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chain, walletType])
  @@index([userId])
  @@index([address])
  @@map("user_wallets")
}

model OrganizerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bvn             String?
  bvnVerified     Boolean   @default(false) @map("bvn_verified")
  bankName        String?   @map("bank_name")
  bankCode        String?   @map("bank_code")
  accountNumber   String?   @map("account_number")
  accountName     String?   @map("account_name")
  bankVerified    Boolean   @default(false) @map("bank_verified")
  kycTier         KycTier   @default(NONE) @map("kyc_tier")
  kycStatus       KycStatus @default(PENDING) @map("kyc_status")
  governmentIdUrl String?   @map("government_id_url")
  selfieUrl       String?   @map("selfie_url")
  businessName    String?   @map("business_name")
  businessAddress String?   @map("business_address")

  // Provider-side split settlement identifiers, populated when an
  // organizer completes /become-organizer. Each gateway gets its own
  // subaccount so PaymentsService can route a 97/3 split per
  // transaction without HostIT custodying funds.
  paystackSubaccountCode String? @map("paystack_subaccount_code")
  paystackSubaccountId   String? @map("paystack_subaccount_id")
  monnifySubAccountCode  String? @map("monnify_sub_account_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("organizer_profiles")
}

model Event {
  id                String        @id @default(uuid()) @db.Uuid
  organizerId       String        @map("organizer_id") @db.Uuid
  name              String        @db.VarChar(100)
  slug              String        @unique
  description       String
  venue             String        @db.VarChar(200)
  location          String
  category          EventCategory
  coverImage        String?       @map("cover_image")
  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  purchaseStartTime DateTime      @map("purchase_start_time")
  status            EventStatus   @default(DRAFT)
  // Country where the event is held — drives fiat provider eligibility
  // and currency. ISO-3166-1 alpha-2.
  country           String        @default("NG")
  // Settlement / display currency. ISO-4217. Tied to country at
  // creation time (NG → NGN, US → USD, etc.).
  currency          String        @default("NGN")
  // Which blockchain the on-chain entries (per ticket type) live on.
  // Drives BlockchainReadService + CircleContractService dispatch.
  chain             String        @default("BASE-SEPOLIA")
  // Organizer toggle for accepting crypto checkout in addition to
  // (or instead of) any country-local fiat providers. Always on by
  // default — crypto is HostIT's universal payment lane.
  acceptsCrypto     Boolean       @default(true) @map("accepts_crypto")
  isFree            Boolean       @default(false) @map("is_free")
  isRefundable      Boolean       @default(false) @map("is_refundable")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organizer              User                    @relation(fields: [organizerId], references: [id])
  ticketTypes            TicketType[]
  tickets                Ticket[]
  transactions           Transaction[]
  payouts                Payout[]
  blockchainTransactions BlockchainTransaction[]

  @@index([organizerId])
  @@map("events")
}

model TicketType {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  name            String
  description     String?
  price           Decimal   @db.Decimal
  quantity        Int
  maxPerUser      Int       @default(5) @map("max_per_user")
  soldCount       Int       @default(0) @map("sold_count")
  salesStartDate  DateTime? @map("sales_start_date")
  salesEndDate    DateTime? @map("sales_end_date")
  // On-chain Diamond ticketId returned by createTicket. Each ticket
  // type is its own on-chain entry (one createTicket call per type
  // when the event publishes). Null until the publish job confirms.
  onChainTicketId BigInt?   @unique @map("on_chain_ticket_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

model Ticket {
  id              String          @id @default(uuid()) @db.Uuid
  ticketTypeId    String          @map("ticket_type_id") @db.Uuid
  eventId         String          @map("event_id") @db.Uuid
  buyerId         String?         @map("buyer_id") @db.Uuid
  buyerEmail      String          @map("buyer_email")
  buyerName       String          @map("buyer_name")
  buyerPhone      String?         @map("buyer_phone")
  reference       String          @unique
  qrCode          String?         @map("qr_code")
  tokenId         Int?            @map("token_id")
  status          TicketStatus    @default(PENDING)
  deliveryChannel DeliveryChannel @map("delivery_channel")
  checkedInAt     DateTime?       @map("checked_in_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  transactionId String? @map("transaction_id") @db.Uuid

  ticketType             TicketType              @relation(fields: [ticketTypeId], references: [id])
  event                  Event                   @relation(fields: [eventId], references: [id])
  buyer                  User?                   @relation(fields: [buyerId], references: [id])
  transaction            Transaction?            @relation("TransactionTickets", fields: [transactionId], references: [id])
  transactions           Transaction[]           @relation("LegacyTicketTransaction")
  blockchainTransactions BlockchainTransaction[]
  notifications          Notification[]

  @@index([eventId])
  @@index([eventId, buyerEmail], map: "idx_ticket_event_buyer")
  @@index([transactionId])
  @@map("tickets")
}

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  reference         String            @unique
  quantity          Int               @default(1)
  ticketId          String?           @map("ticket_id") @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  buyerEmail        String            @map("buyer_email")
  amount            Decimal           @db.Decimal
  currency          String            @default("NGN")
  provider          PaymentProvider
  providerReference String?           @map("provider_reference")
  status            TransactionStatus @default(PENDING)
  metadata          Json?

  // Per-transaction invoice ledger. `platformFee` is HostIT's 3%
  // (calculated from gross at init time and locked in). `gatewayFee`
  // is populated from the settlement webhook when the provider
  // reports it. `feeBearer` records who absorbed the gateway fee for
  // future-proofing different commercial terms.
  platformFee     Decimal? @map("platform_fee") @db.Decimal
  organizerAmount Decimal? @map("organizer_amount") @db.Decimal
  gatewayFee      Decimal? @map("gateway_fee") @db.Decimal
  feeBearer       String?  @map("fee_bearer")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticket  Ticket?  @relation("LegacyTicketTransaction", fields: [ticketId], references: [id])
  tickets Ticket[] @relation("TransactionTickets")
  event   Event    @relation(fields: [eventId], references: [id])

  @@index([providerReference])
  @@index([eventId])
  @@map("transactions")
}

model Payout {
  id                String          @id @default(uuid()) @db.Uuid
  organizerId       String          @map("organizer_id") @db.Uuid
  eventId           String          @map("event_id") @db.Uuid
  amount            Decimal         @db.Decimal
  currency          String          @default("NGN")
  provider          PaymentProvider
  providerReference String?         @map("provider_reference")
  status            PayoutStatus    @default(PENDING)
  bankName          String?         @map("bank_name")
  bankCode          String?         @map("bank_code")
  accountNumber     String?         @map("account_number")
  accountName       String?         @map("account_name")
  scheduledDate     DateTime        @map("scheduled_date")
  processedAt       DateTime?       @map("processed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organizer User  @relation(fields: [organizerId], references: [id])
  event     Event @relation(fields: [eventId], references: [id])

  @@index([organizerId])
  @@index([eventId])
  @@map("payouts")
}

model BlockchainTransaction {
  id       String             @id @default(uuid()) @db.Uuid
  ticketId String?            @map("ticket_id") @db.Uuid
  eventId  String?            @map("event_id") @db.Uuid
  txHash   String?            @map("tx_hash")
  type     BlockchainTxType
  status   BlockchainTxStatus @default(PENDING)
  retries  Int                @default(0)
  error    String?

  // Circle reconciliation. `circleTransactionId` is the ID returned by
  // Circle SCP execute calls and matched against transaction webhooks
  // (see issues #65, #67). `chain` disambiguates rows during the
  // Lisk → Base migration.
  circleTransactionId String? @unique @map("circle_transaction_id")
  circleWalletId      String? @map("circle_wallet_id")
  chain               String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id])
  event  Event?  @relation(fields: [eventId], references: [id])

  @@index([txHash])
  @@index([eventId])
  @@map("blockchain_transactions")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  ticketId  String?             @map("ticket_id") @db.Uuid
  channel   NotificationChannel
  type      String
  status    NotificationStatus  @default(PENDING)
  metadata  Json?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([userId])
  @@index([ticketId])
  @@map("notifications")
}
